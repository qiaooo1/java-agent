{"kind":"textbox","id":"sh/87q1cnih","slideIndex":6,"position":{"left":80,"top":50,"width":1000,"height":35},"text":"边缘计算 / 遗传算法","geometry":"rect","lineWidth":0,"style":{"fontSize":18,"typeface":"Arial","color":"#167D9A","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/76h03ihw","slideIndex":6,"position":{"left":80,"top":115,"width":1120,"height":100},"text":"一次交叉与变异示例","geometry":"rect","lineWidth":0,"style":{"fontSize":36,"typeface":"Arial","color":"#142A43","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/m58jad0b","slideIndex":6,"position":{"left":80,"top":245,"width":1100,"height":390},"text":"父代 A：[0, 1, 2, 1]     父代 B：[2, 2, 0, 0]\n在第 2 位之后交叉，得到子代：[0, 1, 0, 0]\n第 3 位发生变异，得到：[0, 1, 2, 0]\n重新计算适应度，并检查服务器容量约束。","geometry":"rect","lineWidth":0,"style":{"fontSize":25,"typeface":"Arial","color":"#334B60","alignment":"left"}}
{"kind":"textbox","id":"sh/hcji9szy","slideIndex":6,"position":{"left":1120,"top":650,"width":80,"height":30},"text":"07","geometry":"rect","lineWidth":0,"style":{"fontSize":16,"typeface":"Arial","color":"#7B8D9F","alignment":"left"}}
{"kind":"notes","id":"nt/8qq5xq","slideIndex":6,"text":""}
