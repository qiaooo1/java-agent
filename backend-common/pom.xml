<project xmlns="http://maven.apache.org/POM/4.0.0"> <!-- 集中实现单库事务与协作设施。 -->
  <modelVersion>4.0.0</modelVersion> <!-- Maven 模型。 -->
  <parent><groupId>com.agent4</groupId><artifactId>agent-workbench-parent</artifactId><version>2.0.0-SNAPSHOT</version></parent> <!-- 统一版本。 -->
  <artifactId>backend-common</artifactId> <!-- 后端基础模块。 -->
  <dependencies> <!-- 显式列出业务基础设施。 -->
    <dependency><groupId>com.agent4</groupId><artifactId>agent-core</artifactId><version>${project.version}</version></dependency> <!-- 共享知识分块与本地向量化，执行入口仍留在 Worker。 -->
    <dependency><groupId>com.agent4</groupId><artifactId>common-contract</artifactId><version>${project.version}</version></dependency> <!-- 领域协议。 -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency> <!-- SQL 与事务。 -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId></dependency> <!-- 原子限流与槽位。 -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-amqp</artifactId></dependency> <!-- RabbitMQ 投递。 -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-json</artifactId></dependency> <!-- 消息序列化。 -->
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency> <!-- 数据库版本迁移。 -->
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId><scope>runtime</scope></dependency> <!-- MySQL 支持位于独立插件，不能仅凭 H2 测试认定迁移可用。 -->
    <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency> <!-- MySQL 驱动。 -->
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency> <!-- 离线事务测试。 -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency> <!-- 并发与故障断言。 -->
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency> <!-- Docker 可用时执行真实中间件集成测试。 -->
    <dependency><groupId>org.testcontainers</groupId><artifactId>mysql</artifactId><scope>test</scope></dependency> <!-- 在隔离 MySQL 上复用全部事务断言。 -->
    <dependency><groupId>org.testcontainers</groupId><artifactId>rabbitmq</artifactId><scope>test</scope></dependency> <!-- 验证真实 broker 发布确认与退回。 -->
  </dependencies> <!-- 结束依赖。 -->
  <profiles><profile><id>integration</id><build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.1.2</version><executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions></plugin></plugins></build></profile></profiles> <!-- 显式 -Pintegration 才启动真实容器，不把未运行的集成测试算作通过。 -->
</project> <!-- 结束模块。 -->
