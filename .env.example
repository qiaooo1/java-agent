# 复制为 .env 后按需修改；真实 .env 已加入忽略列表。
# 网关容器内部仍使用 8080，宿主机默认用独立端口避免冲突。
GATEWAY_HOST_PORT=18080
# RabbitMQ 宿主机调试端口；内部服务始终连接 rabbitmq:5672。
RABBIT_HOST_PORT=18073
# MySQL 业务账号密码，与平台和 Worker 保持一致。
DB_PASSWORD=workbench-local
# 仅本地 Compose 的 MySQL root 密码，业务使用单独用户。
MYSQL_ROOT_PASSWORD=root-local-only
# RabbitMQ 的本地业务用户密码。
RABBIT_PASSWORD=workbench-local
# 平台与网关必须一致，至少三十二字节，公开部署必须替换。
JWT_SECRET=local-development-secret-change-me-32-bytes
# 留空进入明确标识的演示模式，禁止提交真实密钥。
DEEPSEEK_API_KEY=
# 可替换为本地模型模拟服务，但其结果不能算真实 Agent 评估。
LLM_BASE_URL=https://api.deepseek.com
# 平台在提交时将模型名保存为任务配置快照。
LLM_MODEL=deepseek-chat
